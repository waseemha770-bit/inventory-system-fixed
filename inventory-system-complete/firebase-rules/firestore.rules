rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // التحقق من تسجيل الدخول
    function isSignedIn() {
      return request.auth != null;
    }

    // فقط المدراء يمكنهم إدارة المستخدمين
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // جميع المستخدمين المسجلين يمكنهم القراءة والكتابة
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Editor');
      allow delete: if isAdmin();
    }

    match /movements/{movementId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Editor');
      allow delete: if isAdmin();
    }

    match /contacts/{contactId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Editor');
      allow delete: if isAdmin();
    }

    match /returns/{returnId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Editor');
      allow delete: if isAdmin();
    }

    match /accounts/{accountId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Editor');
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
